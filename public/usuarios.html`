<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Usuários - Sistema Paroquial</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="sidebar">
        <h2>⛪ Gestão Paroquial</h2>
        <a href="usuarios.html" class="active">👥 Usuários</a>
        <a href="ministerios.html">⛪ Ministérios</a>
        <a href="eventos.html">📅 Eventos</a>
        <a href="login.html" style="margin-top: auto; color: #e74c3c;">🚪 Sair</a>
    </div>

    <div class="main-content">
        <h1>Gestão de Usuários</h1>
        
        <div class="card">
            <h3 id="form-title">Cadastrar Novo Usuário</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div class="form-group">
                    <label>Nome</label>
                    <input type="text" id="nome">
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="email">
                </div>
                <div class="form-group">
                    <label>Senha</label>
                    <input type="password" id="senha">
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input type="text" id="tel">
                </div>
                <div class="form-group">
                    <label>Tipo de Usuário</label>
                    <select id="tipo">
                        <option value="MEMBRO">MEMBRO</option>
                        <option value="COORDENADOR">COORDENADOR</option>
                        <option value="ADM">ADM</option>
                        <option value="VISITANTE">VISITANTE</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Data de Nascimento</label>
                    <input type="date" id="data_nasc">
                </div>
            </div>
            <input type="hidden" id="user-id">
            <div style="margin-top: 10px;">
                <button class="btn-success" onclick="saveUser()">Salvar Usuário</button>
                <button class="btn-danger" style="background: #95a5a6;" onclick="clearForm()">Limpar</button>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h3>Lista de Usuários</h3>
                <button class="btn-primary" onclick="loadUsers()">🔄 Atualizar Lista</button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Tipo</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="user-table"></tbody>
            </table>
        </div>
    </div>

    <script>
        const API_URL = 'http://localhost:8000';

        if (!localStorage.getItem('token')) {
            window.location.href = 'login.html';
        }

        async function fetchAPI(endpoint, method = 'GET', body = null) {
            const headers = { 'Content-Type': 'application/json' };
            const token = localStorage.getItem('token');
            if (token) headers['Authorization'] = `Bearer ${token}`;

            const options = { method, headers };
            if (body) options.body = JSON.stringify(body);

            const response = await fetch(`${API_URL}${endpoint}`, options);
            return response.json();
        }

        async function loadUsers() {
            try {
                const data = await fetchAPI('/usuarios');
                const tbody = document.getElementById('user-table');
                tbody.innerHTML = '';

                // CORREÇÃO CRÍTICA: Acessando data.data.usuarios conforme o Controller
                if (data.success && data.data && data.data.usuarios) {
                    const users = data.data.usuarios;
                    users.forEach(u => {
                        // Trata campos diferentes dependendo de como o objeto vem (stdClass ou Array)
                        const id = u.idUsuario || u.id_usuarios;
                        const nome = u.nomeUsuario || u.nome;
                        const email = u.email;
                        const tipo = u.tipoUsuario || u.tipo_usuario;
                        const tel = u.tel || '';
                        const dataNasc = u.data_nasc || '';

                        tbody.innerHTML += `
                            <tr>
                                <td>${id}</td>
                                <td>${nome}</td>
                                <td>${email}</td>
                                <td>${tipo}</td>
                                <td>
                                    <button class="btn-primary" onclick="editUser(${id}, '${nome}', '${email}', '${tel}', '${tipo}', '${dataNasc}')">Editar</button>
                                    <button class="btn-danger" onclick="deleteUser(${id})">Excluir</button>
                                </td>
                            </tr>`;
                    });
                } else {
                    alert('Nenhum usuário encontrado ou erro na API.');
                }
            } catch (e) {
                console.error(e);
                alert('Erro ao carregar usuários.');
            }
        }

        async function saveUser() {
            const id = document.getElementById('user-id').value;
            const payload = {
                usuarios: {
                    nomeUsuario: document.getElementById('nome').value,
                    email: document.getElementById('email').value,
                    senha: document.getElementById('senha').value,
                    tel: document.getElementById('tel').value,
                    tipoUsuario: document.getElementById('tipo').value,
                    data_nasc: document.getElementById('data_nasc').value
                }
            };

            const method = id ? 'PUT' : 'POST';
            const endpoint = id ? `/usuarios/${id}` : '/usuarios';

            const result = await fetchAPI(endpoint, method, payload);
            if (result.success) {
                alert('Usuário salvo com sucesso!');
                clearForm();
                loadUsers();
            } else {
                alert('Erro: ' + result.message);
            }
        }

        function editUser(id, nome, email, tel, tipo, data) {
            document.getElementById('user-id').value = id;
            document.getElementById('nome').value = nome;
            document.getElementById('email').value = email;
            document.getElementById('tel').value = tel;
            document.getElementById('tipo').value = tipo;
            document.getElementById('data_nasc').value = data;
            document.getElementById('form-title').innerText = 'Editando Usuário ID: ' + id;
        }

        async function deleteUser(id) {
            if (!confirm('Tem certeza que deseja excluir?')) return;
            const result = await fetchAPI(`/usuarios/${id}`, 'DELETE');
            if (result.success) {
                loadUsers();
            } else {
                alert('Erro: ' + result.message);
            }
        }

        function clearForm() {
            document.getElementById('user-id').value = '';
            document.getElementById('nome').value = '';
            document.getElementById('email').value = '';
            document.getElementById('senha').value = '';
            document.getElementById('tel').value = '';
            document.getElementById('data_nasc').value = '';
            document.getElementById('form-title').innerText = 'Cadastrar Novo Usuário';
        }

        window.onload = loadUsers;
    </script>
</body>
</html>
